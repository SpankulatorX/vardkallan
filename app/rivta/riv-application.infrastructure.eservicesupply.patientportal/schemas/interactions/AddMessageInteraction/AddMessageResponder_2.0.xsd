<xs:schema xmlns:xs='http://www.w3.org/2001/XMLSchema' xmlns:tns='urn:riv-application:infrastructure:eservicesupply:patientportal:AddMessageResponder:2' xmlns:core='urn:riv-application:infrastructure:eservicesupply:patientportal:2' targetNamespace='urn:riv-application:infrastructure:eservicesupply:patientportal:AddMessageResponder:2' elementFormDefault='qualified' attributeFormDefault='unqualified' version='2.0'>
  <xs:import schemaLocation='../../core_components/infrastructure_eservicesupply_patientportal_2.0.xsd' namespace='urn:riv-application:infrastructure:eservicesupply:patientportal:2' />
  <xs:element name='AddMessage' type='tns:AddMessageType' />
  <xs:element name='AddMessageResponse' type='tns:AddMessageResponseType' />
  <xs:complexType name='AddMessageType'>
    <xs:sequence>
      <xs:element name="subjectOfCareId" type="core:SubjectOfCareIdType" />
      <xs:element name="threadId" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Används för att tråda meddelanden. Om fältet ej anges kommer en ny tråd med en automatgenererad identitet skapas.
            Meddelandetrådens id (antingen den tillhandahållna eller den automatiska) returneras i svaret.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="threadTitle" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Om fältet utelämnas vid första meddelandet i en tråd sätts värdet till "Meddelande".
            Utelämnas det vid senare meddelanden i samma tråd förändras inte titeln.
            Om fältet inkluderas vid senare meddelanden skrivs tidigare värde över.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="threadLabel" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Om fältet utelämnas vid första meddelandet i en tråd sätts värdet till "Information".
            Utelämnas det vid senare meddelanden i samma tråd förändras inte labeln.
            Om fältet inkluderas vid senare meddelanden skrivs tidigare värde över.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="message" type="core:MessageType" />
      <xs:element name="notify" type="xs:boolean" />
      <xs:element name="queueForDays" type="xs:integer" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Om invånare ännu inte har ett konto i 1177 VG - antal dagar som meddelandet ska hållas i kö i väntan på att invånare skapar ett konto</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="approve" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Godkänner invånaren för kommunikation på den enhet som meddelandet avser</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="accountableOrganisation" type="core:IIType">
        <xs:annotation>
          <xs:documentation>Sändande organisations id. Används som grund för fakturering.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name='AddMessageResponseType'>
    <xs:sequence>
      <xs:element name="threadId" type="xs:string" minOccurs='0'/>
      <xs:element name='resultCode' type='core:ResultCodeEnum' minOccurs='1' maxOccurs='1' />
      <xs:element name='resultText' type='xs:string' minOccurs='0' maxOccurs='1' />
      <xs:any namespace='##other' processContents='lax' minOccurs='0' maxOccurs='unbounded' />
    </xs:sequence>
  </xs:complexType>
</xs:schema>