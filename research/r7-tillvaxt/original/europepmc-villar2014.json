932-6"}]},"commentCorrectionList":{"commentCorrection":[{"source":"MED","id":"25209472","reference":"Lancet. 2014 Sep 6;384(9946):833-5. doi: 10.1016/S0140-6736(14)61287-3","type":"Comment in","orderIn":1},{"source":"MED","id":"29864016","reference":"Lancet. 2018 May 19;391(10134):1995-1996. doi: 10.1016/S0140-6736(18)30292-7","type":"Comment in","orderIn":2}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":1700,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2014-09-29","dateOfCreation":"2014-09-12","dateOfRevision":"2024-07-10","firstPublicationDate":"2014-09-01","firstIndexDate":"2014-09-13","hasEvaluations":"N"}]}}